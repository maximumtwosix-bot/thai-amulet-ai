# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env ที่มีค่าจริงเด็ดขาด

OPENAI_API_KEY=

# ===== STEP 28 — BACK-OFFICE AUTHENTICATION (single internal admin login) =====
# ตั้งค่าทั้ง 3 ตัวนี้ก่อนใช้งานจริงเสมอ — ไม่มีค่า default ใดๆ ในโค้ด ถ้าไม่ตั้งค่า ระบบจะปฏิเสธ
# ทุก login attempt (ADMIN_USERNAME/ADMIN_PASSWORD ว่าง) และ verifySessionToken จะ throw
# (SESSION_SECRET ว่าง) — เป็นพฤติกรรมที่ตั้งใจ (fail closed ไม่ fallback เป็นค่าลับที่เดาได้)
#
# ADMIN_USERNAME / ADMIN_PASSWORD — บัญชีผู้ดูแลระบบหลังบ้านเพียงบัญชีเดียว ตั้งเป็นค่าที่คาดเดายาก
# SESSION_SECRET — string สุ่มยาวๆ (เช่นสร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
#   ใช้เซ็น session cookie แบบ HMAC — ห้ามเดา ห้ามใช้ค่าสั้น/ค่าที่คาดเดาได้
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=

# ===== STEP 10 — SOCIAL POSTING INTEGRATION (ยังไม่ตั้งค่า = ระบบจะตอบ not_configured เสมอ) =====

# Facebook Graph API — Page Access Token ต้องขอผ่าน Meta for Developers ด้วยบัญชี Page จริง
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Instagram Graph API — ต้องเป็น Instagram Business Account ที่ผูกกับ Facebook Page แล้ว
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok Content Posting API — ต้องขอผ่าน TikTok for Developers
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ===== STEP 12 — SOCIAL POST QUEUE / SCHEDULING =====
# URL สาธารณะของแอปตัวเอง (ต้องเป็น https ที่ Facebook/Instagram/TikTok เข้าถึงได้จริงตอน publish
# จริง) — จำเป็นเฉพาะตอนที่ processScheduledPosts() ทำงานนอก request context (ไม่มี request.url
# ให้ derive origin เหมือน route handler ปกติ) ถ้าไม่ตั้งค่า จะใช้ http://localhost:3000 แทน
APP_BASE_URL=

# ===== STEP 14 — AI VIDEO GENERATION (Replicate) =====
# API token จาก https://replicate.com/account/api-tokens — ยังไม่ตั้งค่า = ระบบจะตอบ
# not_configured เสมอ (ไม่มีทางโพสต์/สร้างวิดีโอปลอม)
REPLICATE_API_TOKEN=
# ชื่อโมเดลบน Replicate ที่จะใช้สร้างวิดีโอ (รูปแบบ "owner/model") — ถ้าไม่ตั้งค่าจะใช้ค่า default
# ในโค้ด (src/lib/ai/video/replicateProvider.ts) ซึ่งควรตรวจสอบว่ายังใช้งานได้จริงก่อน production
# เพราะ catalog ของ Replicate เปลี่ยนแปลงได้ตลอดเวลา
REPLICATE_VIDEO_MODEL=

# ===== STEP 17 — BACKGROUND WORKER / SCHEDULER =====
# โปรเจกต์นี้ไม่มีระบบ authentication ใดๆ เลย (ตรวจสอบแล้ว) — secret นี้เป็นเงื่อนไขเดียวที่ป้องกัน
# ไม่ให้บุคคลทั่วไปสั่ง POST /api/social/worker/run ได้ ถ้าไม่ตั้งค่า endpoint จะปฏิเสธคำขอทุกครั้ง
# โดยอัตโนมัติ (503 not_configured) — ตั้งค่าเป็นสตริงสุ่มยาวๆ แล้วส่งมาผ่าน header
# "x-worker-secret: <ค่านี้>" หรือ "Authorization: Bearer <ค่านี้>" เวลาเรียก endpoint นี้
WORKER_TRIGGER_SECRET=

# ===== STEP 18 — PRODUCTION HARDENING =====
# จำนวนนาทีสูงสุดที่ social_posts รายการหนึ่งจะค้างอยู่ในสถานะ "processing" ก่อนที่ worker รอบถัดไป
# จะถือว่าค้าง (worker ตัวก่อนหน้าอาจ crash/ถูกปิดกลางคัน) แล้วเปลี่ยนเป็น "failed" ให้ตรวจสอบเอง
# (ไม่ retry อัตโนมัติ กันโพสต์ซ้ำถ้าจริงๆ แล้วโพสต์สำเร็จไปแล้วก่อน crash) — ถ้าไม่ตั้งค่าจะใช้ 15
SOCIAL_PROCESSING_TIMEOUT_MINUTES=

# ===== STEP 21 — AI COST TRACKING (pricing เป็น ESTIMATED เท่านั้น ไม่ใช่ actual billing) =====
# ทุกค่าด้านล่างนี้ optional ทั้งหมด — ไม่ตั้งค่า = ระบบจะยังบันทึกทุก AI generation ลง ai_cost_ledger
# ตามปกติ แต่ estimated_cost จะเป็น NULL (ไม่ใช่ 0) เพราะไม่มีราคาให้คำนวณ ห้ามเดาตัวเลขราคาใส่ที่นี่
# โดยไม่ตรวจสอบราคาปัจจุบันจริงจาก OpenAI/Replicate ก่อนเสมอ (ราคาที่ตรวจสอบผิด = ต้นทุนประมาณการผิด)
#
# หน่วยเงินที่ตัวเลขทั้งหมดด้านล่างอ้างอิงถึง (default "USD" ถ้าไม่ตั้งค่า)
COST_CURRENCY=

# OpenAI Text (gpt-5-mini ผ่าน Responses API) — ราคาต่อ 1,000 token
OPENAI_TEXT_PRICE_INPUT_PER_1K=
OPENAI_TEXT_PRICE_OUTPUT_PER_1K=

# OpenAI Image (gpt-image-1) — ราคาต่อภาพ (ระบบนี้สร้างครั้งละ 1 ภาพ ขนาด 1024x1024 เสมอ) แยกตาม
# quality tier ที่ระบบอ่านได้จริงจาก response ของ OpenAI ต่อครั้ง (response.quality — ดู
# src/lib/ai/imageGeneration.ts) เพราะ request ที่ส่งไปใช้ quality: "auto" ซึ่งไม่มีเอกสารยืนยันว่า
# resolve เป็น tier ไหนคงที่เสมอ ราคาอ้างอิงที่ยืนยันได้จาก
# https://developers.openai.com/api/docs/models/gpt-image-1 (ตรวจสอบ 2026-08-29 — ควรตรวจสอบซ้ำก่อน
# ใช้จริงเพราะราคาผู้ให้บริการเปลี่ยนได้): low ≈ 0.011 / medium ≈ 0.042 / high ≈ 0.167 (USD ต่อภาพ)
OPENAI_IMAGE_PRICE_PER_IMAGE_LOW=
OPENAI_IMAGE_PRICE_PER_IMAGE_MEDIUM=
OPENAI_IMAGE_PRICE_PER_IMAGE_HIGH=

# OpenAI TTS (tts-1-hd) — ราคาต่อ 1,000 ตัวอักษร input
OPENAI_TTS_PRICE_PER_1K_CHARS=

# Replicate Video — โมเดลกำหนดได้ผ่าน REPLICATE_VIDEO_MODEL ด้านบน ซึ่งแต่ละโมเดลราคาต่างกัน
# ตั้งค่าได้ 2 แบบ (ใช้อย่างใดอย่างหนึ่งหรือทั้งคู่ก็ได้ — ถ้ารู้ duration จริงแล้วและตั้ง PER_SECOND ไว้
# ระบบจะใช้ PER_SECOND คำนวณแทน PER_GENERATION เพราะแม่นยำกว่า):
REPLICATE_VIDEO_PRICE_PER_GENERATION=
REPLICATE_VIDEO_PRICE_PER_SECOND=
