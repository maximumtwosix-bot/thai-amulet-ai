import { NextResponse } from "next/server";
import db from "@/lib/db";
import { generateProductImage, isAiImageGenerationConfigured } from "@/lib/ai/imageGeneration";
import { buildAmuletImagePrompt } from "@/lib/ai/promptBuilder";
import { insertProductMedia } from "@/lib/productMedia";
import { calculateEstimatedCost } from "@/lib/costConfig";
import { finalizeAiGenerationCost, recordAiGeneration } from "@/lib/costLedger";

const IMAGE_MODEL = "gpt-image-1";

export const runtime = "nodejs";

type RouteContext = {
  params: Promise<{ id: string }>;
};

type Product = {
  id: number;
  name: string;
  category: string | null;
};

function parseProductId(rawId: string): number | null {
  const productId = Number(rawId);

  if (!Number.isInteger(productId) || productId <= 0) {
    return null;
  }

  return productId;
}

const MAX_CUSTOM_PROMPT_LENGTH = 2000;

export async function POST(request: Request, context: RouteContext) {
  let ledgerId: number | null = null;
  let ledgerFinalized = false;

  try {
    const { id } = await context.params;
    const productId = parseProductId(id);

    if (productId === null) {
      return NextResponse.json(
        { error: "กรุณาระบุรหัสสินค้าให้ถูกต้อง" },
        { status: 400 }
      );
    }

    const product = db
      .prepare("SELECT id, name, category FROM products WHERE id = ?")
      .get(productId) as Product | undefined;

    if (!product) {
      return NextResponse.json(
        { error: `ไม่พบสินค้ารหัส ${productId}` },
        { status: 404 }
      );
    }

    // ห้าม fake success — เช็ค credential ก่อนเสมอ ไม่ยิง network request ถ้ายังไม่พร้อม
    if (!isAiImageGenerationConfigured()) {
      return NextResponse.json(
        {
          success: false,
          status: "not_configured",
          error: "ยังไม่ได้ตั้งค่า OPENAI_API_KEY สำหรับสร้างภาพด้วย AI",
        },
        { status: 503 }
      );
    }

    // STEP 19: รับ prompt กำหนดเองได้ (เช่นจาก Content Plan's image_prompt) — ทางเลือกเท่านั้น
    // ไม่มี body หรือ body ไม่ใช่ JSON ก็ยังทำงานได้ปกติ (fallback ไป buildAmuletImagePrompt เดิม)
    // STEP 21: รับ contentPlanId เพิ่มเติมได้ (optional) เพื่อผูก AI Cost Ledger กลับไปยังแผนที่สั่งสร้าง
    // ภาพนี้ — ถ้าไม่ส่งมาก็ยังทำงานได้ปกติทุกประการ เหมือนเดิม
    let customPrompt = "";
    let contentPlanId: number | null = null;

    try {
      const body = (await request.json()) as { prompt?: string; contentPlanId?: number };

      if (typeof body?.prompt === "string") {
        customPrompt = body.prompt.trim();
      }

      if (
        typeof body?.contentPlanId === "number" &&
        Number.isInteger(body.contentPlanId) &&
        body.contentPlanId > 0
      ) {
        contentPlanId = body.contentPlanId;
      }
    } catch {
      // ไม่มี body หรือ body ไม่ใช่ JSON — ใช้ prompt อัตโนมัติตามเดิม ไม่ถือเป็น error
    }

    if (customPrompt.length > MAX_CUSTOM_PROMPT_LENGTH) {
      return NextResponse.json(
        { error: `prompt ยาวเกินไป (สูงสุด ${MAX_CUSTOM_PROMPT_LENGTH} ตัวอักษร)` },
        { status: 400 }
      );
    }

    const prompt = customPrompt || buildAmuletImagePrompt(product);

    const ledger = recordAiGeneration({
      productId,
      contentPlanId,
      provider: "openai",
      model: IMAGE_MODEL,
      operation: "image_generate",
      inputUnits: 1,
    });

    ledgerId = ledger.id;

    let generated;

    try {
      generated = await generateProductImage(prompt);
    } catch (error) {
      const message =
        error instanceof Error ? error.message : "ไม่สามารถสร้างภาพด้วย AI ได้";

      finalizeAiGenerationCost(ledger.id, {
        status: "failed",
        metadataPatch: { error: message },
      });
      ledgerFinalized = true;

      console.error(`POST /api/products/${productId}/media/generate error:`, error);

      return NextResponse.json(
        {
          success: false,
          status: "error",
          error: message,
        },
        { status: 502 }
      );
    }

    const estimate = calculateEstimatedCost({
      provider: "openai",
      operation: "image",
      imageCount: 1,
    });

    const media = insertProductMedia({
      productId,
      fileName: generated.fileName,
      imageUrl: generated.imageUrl,
      source: "ai",
    });

    finalizeAiGenerationCost(ledger.id, {
      status: "succeeded",
      outputUnits: 1,
      estimatedCost: estimate.cost,
      // quality/usage มาจาก response ของ OpenAI จริง (ดู imageGeneration.ts) ไม่ใช่ค่าสมมติ —
      // เก็บไว้เผื่อออกแบบ pricing แยกตาม tier ในอนาคต (ยังไม่คิดราคาจากค่านี้ตอนนี้)
      metadataPatch: {
        pricingReason: estimate.reason,
        fileSize: generated.size,
        quality: generated.quality,
        usage: generated.usage,
      },
    });
    ledgerFinalized = true;

    return NextResponse.json({
      success: true,
      media,
      message: "สร้างภาพด้วย AI สำเร็จ (ภาพนี้เป็นภาพประกอบสไตล์ทั่วไป ไม่ใช่ภาพของจริง)",
    });
  } catch (error) {
    console.error("POST /api/products/[id]/media/generate error:", error);

    if (ledgerId !== null && !ledgerFinalized) {
      finalizeAiGenerationCost(ledgerId, {
        status: "failed",
        metadataPatch: { error: error instanceof Error ? error.message : String(error) },
      });
    }

    return NextResponse.json(
      {
        error:
          error instanceof Error ? error.message : "ไม่สามารถสร้างภาพด้วย AI ได้",
      },
      { status: 500 }
    );
  }
}
