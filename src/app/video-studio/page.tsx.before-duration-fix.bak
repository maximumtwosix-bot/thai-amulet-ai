"use client";

import { useEffect, useRef, useState } from "react";
import { useSearchParams } from "next/navigation";

type TimelineItem = {
  id: string;
  fileName: string;
  start: number;
  duration: number;
  index: number;
};

export default function VideoStudioPage() {
  const searchParams = useSearchParams();

  const [script, setScript] = useState("");
  const [audioUrl, setAudioUrl] = useState("");
  const [mediaFiles, setMediaFiles] = useState<File[]>([]);
  const [audioDuration, setAudioDuration] = useState(0);
  const [timeline, setTimeline] = useState<TimelineItem[]>([]);
  const [status, setStatus] = useState("");

  const audioRef = useRef<HTMLAudioElement | null>(null);

  useEffect(() => {
    const scriptFromUrl = searchParams.get("script");
    const audioUrlFromUrl = searchParams.get("audioUrl");

    if (scriptFromUrl) {
      setScript(scriptFromUrl);
    }

    if (audioUrlFromUrl) {
      setAudioUrl(audioUrlFromUrl);
      setStatus("✅ รับสคริปต์และเสียงพากย์จาก Voice Studio แล้ว");
    }
  }, [searchParams]);

  function handleMediaChange(
    event: React.ChangeEvent<HTMLInputElement>
  ) {
    const files = Array.from(event.target.files || []);

    const validFiles = files.filter(
      (file) =>
        file.type.startsWith("image/") ||
        file.type.startsWith("video/")
    );

    setMediaFiles(validFiles);
    setTimeline([]);

    if (validFiles.length !== files.length) {
      setStatus("ระบบรับเฉพาะไฟล์รูปภาพหรือวิดีโอ");
    } else {
      setStatus(`เลือกสื่อแล้ว ${validFiles.length} ไฟล์`);
    }
  }

  function handleAudioLoaded() {
    const duration = audioRef.current?.duration || 0;

    if (Number.isFinite(duration) && duration > 0) {
      setAudioDuration(duration);
    }
  }

  function createTimeline() {
    if (!script.trim()) {
      setStatus("กรุณาระบุสคริปต์ก่อน");
      return;
    }

    if (!audioUrl) {
      setStatus("กรุณาสร้างหรือเลือกเสียงพากย์ก่อน");
      return;
    }

    if (!audioDuration) {
      setStatus("กำลังอ่านความยาวเสียง กรุณารอสักครู่");
      return;
    }

    if (mediaFiles.length === 0) {
      setStatus("กรุณาเลือกรูปภาพหรือวิดีโออย่างน้อย 1 ไฟล์");
      return;
    }

    const durationPerFile = audioDuration / mediaFiles.length;

    const newTimeline: TimelineItem[] = mediaFiles.map(
      (file, index) => ({
        id: `${file.name}-${file.size}-${index}`,
        fileName: file.name,
        start: index * durationPerFile,
        duration: durationPerFile,
        index: index + 1,
      })
    );

    setTimeline(newTimeline);

    setStatus(
      `✅ สร้าง Timeline สำเร็จ ${newTimeline.length} Scene`
    );
  }

  function formatTime(seconds: number) {
    const minutes = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);

    return `${minutes}:${secs.toString().padStart(2, "0")}`;
  }

  return (
    <main className="min-h-screen bg-black p-6 text-white">
      <div className="mx-auto max-w-5xl">
        <h1 className="text-3xl font-bold">
          🎬 Video Studio
        </h1>

        <p className="mt-2 text-gray-400">
          สร้างวิดีโอสำหรับ THAI AMULET TH
        </p>

        <section className="mt-8 rounded-2xl border border-gray-800 bg-gray-950 p-6">
          <h2 className="text-xl font-semibold">
            📝 1. สคริปต์
          </h2>

          <textarea
            value={script}
            onChange={(event) => setScript(event.target.value)}
            placeholder="ใส่สคริปต์สำหรับวิดีโอ..."
            className="mt-4 min-h-[220px] w-full rounded-xl border border-gray-700 bg-gray-900 p-4 text-white outline-none"
          />
        </section>

        <section className="mt-6 rounded-2xl border border-gray-800 bg-gray-950 p-6">
          <h2 className="text-xl font-semibold">
            🎙️ 2. เสียงพากย์
          </h2>

          {audioUrl ? (
            <div className="mt-4 rounded-xl bg-gray-900 p-4">
              <p className="mb-3 font-medium">
                🔊 เสียงพากย์พร้อมใช้งาน
              </p>

              <audio
                ref={audioRef}
                controls
                src={audioUrl}
                onLoadedMetadata={handleAudioLoaded}
                className="w-full"
              />

              {audioDuration > 0 && (
                <p className="mt-3 text-sm text-gray-400">
                  ความยาวเสียง:{" "}
                  <span className="text-white">
                    {formatTime(audioDuration)}
                  </span>
                </p>
              )}
            </div>
          ) : (
            <div className="mt-4 rounded-xl border border-dashed border-gray-700 p-5 text-gray-500">
              ยังไม่มีเสียงพากย์
            </div>
          )}
        </section>

        <section className="mt-6 rounded-2xl border border-gray-800 bg-gray-950 p-6">
          <h2 className="text-xl font-semibold">
            🖼️ 3. รูปภาพ / คลิป
          </h2>

          <input
            type="file"
            accept="image/*,video/*"
            multiple
            onChange={handleMediaChange}
            className="mt-4 block w-full rounded-xl border border-gray-700 bg-gray-900 p-3 text-sm"
          />

          {mediaFiles.length > 0 && (
            <div className="mt-4">
              <p className="font-medium">
                📁 เลือกแล้ว {mediaFiles.length} ไฟล์
              </p>

              <div className="mt-3 space-y-2">
                {mediaFiles.map((file, index) => (
                  <div
                    key={`${file.name}-${file.size}-${index}`}
                    className="rounded-lg bg-gray-900 p-3 text-sm"
                  >
                    {index + 1}. {file.name}
                  </div>
                ))}
              </div>
            </div>
          )}
        </section>

        <section className="mt-6 rounded-2xl border border-gray-800 bg-gray-950 p-6">
          <h2 className="text-xl font-semibold">
            🎞️ 4. Timeline
          </h2>

          {timeline.length === 0 ? (
            <div className="mt-4 rounded-xl border border-dashed border-gray-700 p-8 text-center text-gray-500">
              Timeline จะถูกสร้างอัตโนมัติจากเสียงและรูป/คลิป
            </div>
          ) : (
            <div className="mt-4 space-y-3">
              {timeline.map((item) => (
                <div
                  key={item.id}
                  className="rounded-xl border border-gray-800 bg-gray-900 p-4"
                >
                  <div className="flex items-center justify-between gap-4">
                    <div>
                      <p className="font-semibold">
                        🎬 Scene {item.index}
                      </p>

                      <p className="mt-1 text-sm text-gray-400">
                        {item.fileName}
                      </p>
                    </div>

                    <div className="text-right text-sm">
                      <p>
                        {formatTime(item.start)} →{" "}
                        {formatTime(item.start + item.duration)}
                      </p>

                      <p className="mt-1 text-gray-400">
                        {item.duration.toFixed(1)} วินาที
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>

        {status && (
          <div className="mt-6 rounded-xl border border-gray-700 bg-gray-900 p-4">
            {status}
          </div>
        )}

        <button
          type="button"
          disabled={
            !script.trim() ||
            !audioUrl ||
            mediaFiles.length === 0
          }
          onClick={createTimeline}
          className="mt-6 rounded-xl bg-white px-6 py-3 font-semibold text-black disabled:cursor-not-allowed disabled:opacity-40"
        >
          🎬 สร้าง Timeline อัตโนมัติ
        </button>
      </div>
    </main>
  );
}
