import db from "@/lib/db";
import { getCostCurrency } from "@/lib/costConfig";

// created_at ในตาราง ai_cost_ledger ถูกเขียนด้วย SQLite CURRENT_TIMESTAMP ซึ่งคืนรูปแบบ
// "YYYY-MM-DD HH:MM:SS" (เว้นวรรค ไม่มี "T"/"Z", เวลา UTC) ไม่ใช่ ISO 8601 เต็มรูปแบบที่
// Date.prototype.toISOString() คืนมา ("YYYY-MM-DDTHH:mm:ss.sssZ") — ถ้าเทียบ string กันตรงๆ คนละ
// รูปแบบ การเปรียบเทียบ >= / <= จะผิดพลาด (เช่น " " < "T" ทำให้แถวเวลาเดียวกันดูเหมือน "น้อยกว่า"
// เสมอ) ทุกจุดที่ query ช่วงเวลาใน ai_cost_ledger ต้องแปลงผ่านฟังก์ชันนี้ก่อนเทียบกับ created_at เสมอ
export function toSqliteTimestamp(date: Date): string {
  return date.toISOString().slice(0, 19).replace("T", " ");
}

// AI Cost Ledger service — STEP 21
//
// นี่คือ accounting/observability layer เท่านั้น — ห้ามใช้ตาราง/ฟังก์ชันในไฟล์นี้เพื่อจำกัดจำนวนการ
// สร้าง AI ไม่ว่ากรณีใด (ไม่มี quota, ไม่มี limit, ไม่มี rate limit ในไฟล์นี้)
//
// รูปแบบการใช้งาน (two-phase เดียวกับ social_worker_runs — STEP 18):
//   1) recordAiGeneration()        — เรียกก่อนยิง provider จริง สร้างแถว status='processing'
//   2) finalizeAiGenerationCost()  — เรียกหลังรู้ผลจริง (สำเร็จ/ล้มเหลว) อัปเดต status/usage/cost
//
// ห้าม overwrite actual_cost ด้วย estimated_cost เด็ดขาด — สองคอลัมน์นี้แยกกันโดยสิ้นเชิงเสมอ

export type AiCostProvider = "openai" | "replicate";
export const AI_COST_PROVIDERS: AiCostProvider[] = ["openai", "replicate"];

export function isValidAiCostProvider(value: string): value is AiCostProvider {
  return (AI_COST_PROVIDERS as string[]).includes(value);
}

export type AiCostOperation =
  | "text_generate"
  | "content_plan_generate"
  | "weekly_plan_generate"
  | "image_generate"
  | "video_generate"
  | "voice_generate";

export const AI_COST_OPERATIONS: AiCostOperation[] = [
  "text_generate",
  "content_plan_generate",
  "weekly_plan_generate",
  "image_generate",
  "video_generate",
  "voice_generate",
];

export function isValidAiCostOperation(value: string): value is AiCostOperation {
  return (AI_COST_OPERATIONS as string[]).includes(value);
}

export type AiCostStatus = "processing" | "succeeded" | "failed";
export const AI_COST_STATUSES: AiCostStatus[] = ["processing", "succeeded", "failed"];

export function isValidAiCostStatus(value: string): value is AiCostStatus {
  return (AI_COST_STATUSES as string[]).includes(value);
}

